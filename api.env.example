# Copy to `api.env` and fill in. `api.env` is git-ignored (add it to .gitignore).
# Only the API container reads this file. Defaults live in EnvironmentVariables.cs.

# --- Database (DB_HOST is set to `db` in docker-compose.yml, don't set it here) ---
DB_NAME=mainDB
DB_USER=postgres
DB_PASSWORD=change-me-strong
DB_PORT=5432

# --- Public URLs (used for JWT issuer/audience + CORS allow-list) ---
# Must match the domain served by Nginx Proxy Manager.
API_BACK_URL=https://mypanelexpress.example.com
API_FRONT_URL=https://mypanelexpress.example.com

# --- Auth / JWT ---
JWT_KEY=change-me-to-a-long-random-secret-at-least-64-chars
TOKEN_VALIDITY_MINUTES=30
COOKIES_VALIDITY_DAYS=7

# --- Seed admin accounts ---
ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# --- Mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
DO_NO_REPLY_MAIL=ne-pas-repondre@example.com

# --- Object storage: MinIO (images served via /media, re-signed on the API) ---
MINIO_ENDPOINT=
MINIO_BUCKETNAME=bonprof
MINIO_ACCESSKEY=
MINIO_SECRETKEY=

# --- Cloudflare R2 (if used instead of / alongside MinIO) ---
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET=
CLOUDFLARE_PUBLIC_URL=

# --- Stripe ---
STRIPE_PK=
STRIPE_SK=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- INSEE Sirene (SIRET check on teacher signup) ---
INSEE_API_KEY=

# --- Optional: expose Swagger UI in prod (defaults off) ---
# ALLOW_DEMO_SEED=false
